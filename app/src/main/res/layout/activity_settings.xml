<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f4ee">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="计步"
            android:textColor="#2a2c26"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5c5e54"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_steps_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+10" />

            <Button
                android:id="@+id/btn_steps_100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+100" />

            <Button
                android:id="@+id/btn_steps_1000"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+1000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/step_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="自定义步数"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1" />

            <Button
                android:id="@+id/btn_steps_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="添加" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="存档 (EEPROM)"
            android:textColor="#2a2c26"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eeprom_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5c5e54"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="导出存档" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导入存档" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="IR 桥接"
            android:textColor="#2a2c26"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ir_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="状态：未启用"
            android:textColor="#5c5e54"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/ir_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="桥接服务器主机名 / IP"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/ir_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="端口（默认 9876）"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <Button
            android:id="@+id/ir_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="启用 IR 桥接" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="关于"
            android:textColor="#2a2c26"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IR 桥接通过 TCP 连接到中转服务，与游戏或实体宝可梦计步器交换密码数据。手机没有红外硬件，无法直接与 NDS 通讯。存档为标准 64KB EEPROM 镜像，可与硬件版固件互通。\n\n基于 picowalker / picowalker-core 开源项目移植。"
            android:textColor="#5c5e54"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
